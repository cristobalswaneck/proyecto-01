# Copiar a .env (permisos 600) y rellenar. Nunca subir .env a git.

# --- Anthropic (fase 1) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Telegram (fase 3) ---
TELEGRAM_BOT_TOKEN=
# IDs de usuario permitidos, separados por comas
TELEGRAM_ALLOWED_USER_IDS=

# --- Notion (fase 4) ---
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# --- Rutas ---
DB_PATH=data/gastos.db
IMAGES_DIR=data/images

# --- Límites ---
MAX_IMAGE_BYTES=10000000
