# Copiar a .env y rellenar (en desarrollo). En Railway estas son las "Variables" del servicio.
# Nunca subir .env a git.

# --- Acceso ---
# Contraseña única de la web. En producción (NODE_ENV=production) es OBLIGATORIA.
APP_PASSWORD=
# Cadena aleatoria larga para firmar la cookie de sesión (mínimo 16 caracteres en producción).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Lector de tickets ---
# stub   = datos de DEMOSTRACIÓN (no lee la imagen). Valor por defecto.
# claude = lector real con la API de Anthropic (pendiente de implementar, fase W1).
EXTRACTOR=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Datos ---
# Carpeta de la base SQLite y de las imágenes. En Railway: la ruta de montaje del volumen (p. ej. /data).
DATA_DIR=data
MAX_IMAGE_BYTES=10000000
PORT=3000
