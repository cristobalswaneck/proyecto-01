    "@types/node": "26.6.6",
    "better-sqlite3": "13.2.0",
    "chart.js": "4.6.1",
    "fastify": "5.12.8",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
